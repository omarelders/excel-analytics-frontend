{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self'; manifest-src 'self'; media-src data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), usb=(), serial=(), bluetooth=(), payment=(), display-capture=(), idle-detection=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shipments",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/shipments"
    },
    {
      "source": "/shipments/:path*",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/shipments/:path*"
    },
    {
      "source": "/upload",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/upload"
    },
    {
      "source": "/upload/:path*",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/upload/:path*"
    },
    {
      "source": "/payments",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/payments"
    },
    {
      "source": "/payments/:path*",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/payments/:path*"
    },
    {
      "source": "/notifications",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/notifications"
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/notifications/:path*"
    },
    {
      "source": "/statuses",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/statuses"
    },
    {
      "source": "/health",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://our-shipping-app-8d9c08b8da37.herokuapp.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
